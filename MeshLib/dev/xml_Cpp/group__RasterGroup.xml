        <definition>MR_BIND_IGNORE Expected&lt; void &gt; MR::convertRasterToFloats</definition>
        <argsstring>(const Raster &amp;raster, float *dst, size_t size)</argsstring>
        <name>convertRasterToFloats</name>
        <qualifiedname>MR::convertRasterToFloats</qualifiedname>
        <param>

        <name>addSplitFaces</name>
        <qualifiedname>mrmeshpy.AABBTree.addSplitFaces</qualifiedname>
        <param>
          <type>self</type>
          <defname>self</defname>
        </param>
        <param>
          <type><ref refid="classmrmeshpy_1_1Mesh" kindref="compound">Mesh</ref></type>

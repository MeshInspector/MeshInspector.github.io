        <type><ref refid="classmrmeshpy_1_1Mesh" kindref="compound">Mesh</ref></type>
        <definition> Mesh mrmeshpy.PlanarTriangulation.triangulateDisjointContours</definition>
        <argsstring>(Mesh mesh, std_vector_std_vector_Id_EdgeTag loops, Vector3f normal, WholeEdgeMap outPatchMap=None)</argsstring>
        <name>triangulateDisjointContours</name>
        <qualifiedname>mrmeshpy.PlanarTriangulation.triangulateDisjointContours</qualifiedname>
        <param>
          <type><ref refid="classmrmeshpy_1_1Mesh" kindref="compound">Mesh</ref></type>

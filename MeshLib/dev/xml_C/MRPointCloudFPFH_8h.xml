        <name>MR_computeFPFH</name>
        <param>
          <type>const <ref refid="MRCtm_8h_1aa319738c95f0bbde075b7ef777cf2665" kindref="member">MR_PointCloud</ref> *</type>
          <declname>pointCloud</declname>

        <type>void</type>
        <definition>void MR::straightenBoundary</definition>
        <argsstring>(Mesh &amp;mesh, EdgeId bd, float minNeiNormalsDot, float maxTriAspectRatio, FaceBitSet *newFaces=nullptr)</argsstring>
        <name>straightenBoundary</name>
        <qualifiedname>MR::straightenBoundary</qualifiedname>
        <param>
          <type>Mesh &amp;</type>
          <declname>mesh</declname>
        </param>
        <param>

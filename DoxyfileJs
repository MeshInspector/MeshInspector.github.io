@INCLUDE = DoxyfileBase

PROJECT_NAME           = "MeshLib JavaScript Docs"
EXTENSION_MAPPING      = mts=c++
# The doc comments are copied from the C++ headers: their \ref and \snippet targets are absent
# from this module, and \param names the C++ parameter where the JS one was renamed (in -> in_).
WARN_IF_DOC_ERROR      = NO
LAYOUT_FILE            = ../MeshLib/doxygen/DoxygenLayoutJs.xml
# The declarations staged by the docs CI (update-docs.yml): the generated .d.mts tree, or the
# Embind bindings.d.mts.
INPUT                  = ../MeshLib/scripts/npm/meshlib \
                         ../MeshLib/doxygen/APIJsPage.dox
FILE_PATTERNS          = *.mts \
                         *.dox
FILTER_PATTERNS        = */bindings.d.mts=preprocessors/typescript-embind.py \
                         *.mts=preprocessors/typescript-mrbind.py
HTML_OUTPUT            = html/Js

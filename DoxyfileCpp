@INCLUDE = DoxyfileBase

PROJECT_NAME           = "MeshLib C++ Docs"
LAYOUT_FILE            = ../MeshLib/doxygen/DoxygenLayoutCpp.xml
INPUT                  = ../MeshLib/source \
                         ../MeshLib/doxygen/APICppPage.dox
FILE_PATTERNS          = *.h \
                         *.dox
EXCLUDE                = ../MeshLib/source/OpenCTM \
                         ../MeshLib/source/MRMesh/miniply.h \
                         ../MeshLib/source/MRMesh/MRphmap.h \
                         ../MeshLib/source/MRDotNet* \
                         ../MeshLib/source/MRMeshC \
                         ../MeshLib/source/MeshLibC2 \
                         ../MeshLib/source/MRViewer/MRGladGlfw.h \
                         ../MeshLib/source/MRMesh/MRCanonicalTypedefs.h \
                         ../MeshLib/source/MRMesh/MRFormat.h
EXCLUDE_PATTERNS       = imgui* \
                         MRPch* \
                         exports.h \
                         resource.h \
                         */MRTest*/*
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = MR_CANONICAL_TYPEDEFS \
                         "MR_BIND_PREFERRED_NAME(...)=" \
                         "MR_BIND_OVERLOAD_SUFFIX(...)=" \
                         "MR_REQUIRES_IF_SUPPORTED(...)=" \
                         MR_BIND_IGNORE= \
                         MR_BIND_IGNORE_PY= \
                         MR_BIND_PREFER_UNLOCK_GIL_WHEN_USED_AS_PARAM= \
                         MR_LIFETIMEBOUND= \
                         MR_LIFETIMEBOUND_NESTED= \
                         MR_NO_UNIQUE_ADDRESS= \
                         MRCOMMONPLUGINS_API= MRCOMMONPLUGINS_CLASS= \
                         MRCUDA_API= MRCUDA_CLASS= \
                         MREMBEDDEDPYTHON_API= MREMBEDDEDPYTHON_CLASS= \
                         MRIOEXTRAS_API= MRIOEXTRAS_CLASS= \
                         MRMCP_API= MRMCP_CLASS= \
                         MRMESH_API= MRMESH_CLASS= \
                         MRPYTHON_API= MRPYTHON_CLASS= \
                         MRSYMBOLMESH_API= MRSYMBOLMESH_CLASS= \
                         MRVIEWER_API= MRVIEWER_CLASS= \
                         MRVOXELS_API= MRVOXELS_CLASS=
SKIP_FUNCTION_MACROS   = YES
EXAMPLE_PATH           = ../MeshLib/examples
EXCLUDE_SYMBOLS        = Json std
HTML_OUTPUT            = html/Cpp
FULL_PATH_NAMES        = YES # need add STRIP_FROM_INC_PATH and STRIP_FROM_PATH
